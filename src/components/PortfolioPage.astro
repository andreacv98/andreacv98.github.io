---
import Layout from '../layouts/Layout.astro';
import { socialLinks, type Locale, type PortfolioContent } from '../data/portfolio';

interface Props {
  locale: Locale;
  content: PortfolioContent;
}

const { locale, content } = Astro.props;
---

<Layout locale={locale} content={content}>
  <header class="site-header">
    <div class="container nav-inner">
      <a href={locale === 'en' ? '/' : '/it/'} class="brand">
        <span class="brand-mark mono">ACV</span>
        <span>Andrea Colli&#8209;Vignarelli</span>
      </a>

      <nav aria-label="Main Navigation">
        <ul class="nav-links">
          <li><a href="#about">{content.nav.about}</a></li>
          <li><a href="#experience">{content.nav.experience}</a></li>
          <li><a href="#projects">{content.nav.projects}</a></li>
          <li><a href="#skills">{content.nav.skills}</a></li>
          <li><a href="#education">{content.nav.education}</a></li>
        </ul>
      </nav>

      <div class="nav-actions">
        <a
          href={content.meta.switchLocaleHref}
          class="lang-switch mono"
          title={`Switch language to ${content.meta.switchLocaleLabel}`}
        >
          <span>🌐</span>
          <span>{content.meta.switchLocaleLabel}</span>
        </a>

        <button
          id="theme-toggle"
          type="button"
          class="icon-btn"
          aria-label="Toggle color scheme"
          title="Toggle light/dark theme"
        >
          <span class="theme-icon-light" aria-hidden="true">🌙</span>
          <span class="theme-icon-dark" aria-hidden="true">☀️</span>
        </button>

        <a
          href={socialLinks.resumePdf}
          target="_blank"
          rel="noopener noreferrer"
          class="icon-btn mono"
        >
          <span>📄</span>
          <span>{content.nav.resumeBtn}</span>
        </a>
      </div>
    </div>
  </header>

  <main>
    <!-- Hero Section -->
    <section id="about" class="hero">
      <div class="container hero-grid">
        <div>
          <div class="status-pill mono">
            <span class="status-dot"></span>
            <span>{content.hero.statusBadge}</span>
          </div>

          <p class="hero-greeting">{content.hero.greeting}</p>
          <h1 class="hero-title">{content.hero.name}</h1>
          <p class="hero-role">
            {content.hero.role} @{' '}
            <a href={content.hero.companyUrl} target="_blank" rel="noopener noreferrer">
              {content.hero.company}
            </a>
          </p>
          <p class="hero-tagline">{content.hero.tagline}</p>

          <div class="hero-bio">
            {content.hero.bio.map((paragraph) => <p>{paragraph}</p>)}
          </div>

          <div class="hero-meta-row">
            <span class="hero-meta-item">
              <span>📍</span>
              <span>{content.hero.location}</span>
            </span>
            <span class="hero-meta-item mono">
              <span>☸️</span>
              <span>Kubernetes · OpenShift Control Plane · Operators · Go</span>
            </span>
          </div>

          <div class="hero-actions">
            <a href="#projects" class="btn btn-primary">
              <span>{content.hero.primaryCta}</span>
              <span>→</span>
            </a>
            <a
              href={socialLinks.resumePdf}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-secondary"
            >
              <span>{content.hero.secondaryCta}</span>
            </a>

            <div class="social-pills">
              <a
                href={socialLinks.github}
                target="_blank"
                rel="noopener noreferrer"
                class="social-btn"
                aria-label="GitHub"
                title="GitHub"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                  <path
                    d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"
                  ></path>
                </svg>
              </a>
              <a
                href={socialLinks.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                class="social-btn"
                aria-label="LinkedIn"
                title="LinkedIn"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                  <path
                    d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"
                  ></path>
                </svg>
              </a>
              <a
                href={socialLinks.stackoverflow}
                target="_blank"
                rel="noopener noreferrer"
                class="social-btn"
                aria-label="StackOverflow"
                title="StackOverflow"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                  <path
                    d="M17.36 20.2v-5.38h1.79V22H3v-7.18h1.8v5.38h12.56zM6.77 14.32l.37-1.76 8.79 1.85-.37 1.76-8.79-1.85zm1.16-4.21l.76-1.61 8.14 3.78-.76 1.62-8.14-3.79zm2.26-3.99l1.15-1.38 6.9 5.76-1.15 1.37-6.9-5.75zm4.45-4.25L20 7.08l-1.44 1.08-5.36-7.21 1.44-1.08zM6.59 18.41v-1.8h8.98v1.8H6.59z"
                  ></path>
                </svg>
              </a>
            </div>
          </div>
        </div>

        <aside class="hero-card">
          <div class="avatar-wrapper">
            <img
              src="/images/andrea.jpg"
              alt="Andrea Colli-Vignarelli"
              width="210"
              height="210"
              fetchpriority="high"
            />
          </div>
          <div class="stats-grid">
            {
              content.hero.stats.map((st) => (
                <div class="stat-box">
                  <div class="stat-value mono">{st.value}</div>
                  <div class="stat-label">{st.label}</div>
                </div>
              ))
            }
          </div>
        </aside>
      </div>
    </section>

    <!-- Experience Section -->
    <section id="experience" class="section">
      <div class="container">
        <div class="section-header">
          <p class="section-eyebrow mono">{content.sections.experience.eyebrow}</p>
          <h2 class="section-title">{content.sections.experience.title}</h2>
          <p class="section-subtitle">{content.sections.experience.subtitle}</p>
        </div>

        <div class="timeline">
          {
            content.experiences.map((exp) => (
              <article class="exp-card">
                <div class="exp-header">
                  <div>
                    <h3 class="exp-role">{exp.role}</h3>
                    <div class="exp-company-row">
                      <a
                        href={exp.companyUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="exp-company"
                      >
                        {exp.company}
                      </a>
                      <span class="exp-location">· {exp.location}</span>
                    </div>
                  </div>
                  <div class="exp-meta-right">
                    {exp.badge && <span class="badge-oss mono">{exp.badge}</span>}
                    <span class="exp-period mono">{exp.period}</span>
                  </div>
                </div>

                <p class="exp-overview">{exp.overview}</p>

                <ul class="exp-highlights">
                  {exp.highlights.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>

                <div class="tag-list">
                  {exp.tags.map((tag) => (
                    <span class="tag mono">{tag}</span>
                  ))}
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Featured Projects & Open Source Section -->
    <section id="projects" class="section">
      <div class="container">
        <div class="section-header">
          <p class="section-eyebrow mono">{content.sections.projects.eyebrow}</p>
          <h2 class="section-title">{content.sections.projects.title}</h2>
          <p class="section-subtitle">{content.sections.projects.subtitle}</p>
        </div>

        <div class="projects-grid">
          {
            content.projects.map((proj) => (
              <article class="project-card">
                <div class="project-top">
                  <div class="project-badge-row">
                    <span class="project-badge mono">{proj.badge}</span>
                  </div>
                  <h3 class="project-title">{proj.title}</h3>
                  <p class="project-subtitle">{proj.subtitle}</p>
                  <p class="project-desc">{proj.description}</p>
                </div>

                <div class="project-footer">
                  <div class="tag-list">
                    {proj.tags.map((tag) => (
                      <span class="tag mono">{tag}</span>
                    ))}
                  </div>

                  <div class="project-links">
                    <a
                      href={proj.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="project-link"
                    >
                      <span>{content.sections.projects.viewRepo}</span>
                      <span>↗</span>
                    </a>
                    {proj.secondaryUrl && (
                      <a
                        href={proj.secondaryUrl.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="project-link"
                      >
                        <span>{proj.secondaryUrl.label}</span>
                        <span>↗</span>
                      </a>
                    )}
                  </div>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Skills Section -->
    <section id="skills" class="section">
      <div class="container">
        <div class="section-header">
          <p class="section-eyebrow mono">{content.sections.skills.eyebrow}</p>
          <h2 class="section-title">{content.sections.skills.title}</h2>
          <p class="section-subtitle">{content.sections.skills.subtitle}</p>
        </div>

        <div class="skills-grid">
          {
            content.skillCategories.map((cat) => (
              <div class="skill-card">
                <h3 class="skill-cat-title">{cat.title}</h3>
                <p class="skill-cat-desc">{cat.description}</p>
                <div class="skill-pills">
                  {cat.skills.map((sk) => (
                    <span class={`skill-pill mono ${sk.primary ? 'primary' : ''}`}>{sk.name}</span>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Education & Certifications Section -->
    <section id="education" class="section">
      <div class="container">
        <div class="section-header">
          <p class="section-eyebrow mono">{content.sections.education.eyebrow}</p>
          <h2 class="section-title">{content.sections.education.title}</h2>
        </div>

        <div class="edu-layout">
          <div class="edu-list">
            {
              content.education.map((ed) => (
                <div class="edu-card">
                  <div class="edu-header">
                    <h3 class="edu-degree">{ed.degree}</h3>
                    <span class="exp-period mono">{ed.period}</span>
                  </div>
                  {ed.specialization && <p class="edu-spec">{ed.specialization}</p>}
                  <div class="edu-inst-row">
                    <a
                      href={ed.institutionUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="exp-company"
                    >
                      {ed.institution}
                    </a>
                    {ed.grade && <span class="edu-grade mono">Grade: {ed.grade}</span>}
                  </div>
                  {ed.details.length > 0 && (
                    <ul class="edu-details">
                      {ed.details.map((d) => (
                        <li>• {d}</li>
                      ))}
                    </ul>
                  )}
                </div>
              ))
            }
          </div>

          <div class="cert-list">
            <h3 class="skill-cat-title">{content.sections.education.certificationsTitle}</h3>
            {
              content.certifications.map((cert) => (
                <div class="cert-card">
                  <h4 class="cert-title">
                    <a
                      href={cert.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="exp-company"
                    >
                      {cert.name} ↗
                    </a>
                  </h4>
                  <p class="cert-issuer">{cert.issuer}</p>
                  <p class="cert-detail">{cert.detail}</p>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container footer-inner">
      <span>{content.sections.footer.rights}</span>
      <span class="mono">{content.sections.footer.builtWith}</span>
    </div>
  </footer>
</Layout>
